# Copy this file to .env and fill in your own values. Never commit .env.
#
# Get both values from your Receivify dashboard: https://receivify.io
# (Settings -> API keys, and Settings -> Webhooks).

# Where your Receivify deployment lives. Use https://receivify.io unless you self-host.
RECEIVIFY_URL=https://receivify.io

# Your secret API key. Server-side only: never ship it to a browser or a mobile app.
RECEIVIFY_API_KEY=rcv_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your webhook signing secret, used to check that webhooks really came from Receivify.
RECEIVIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only while rotating the webhook secret: put the OLD secret here for up to 24 hours,
# then delete this line.
# RECEIVIFY_WEBHOOK_SECRET_PREVIOUS=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
