<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>Receivify.Tests</AssemblyName>
    <RootNamespace>Receivify.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Receivify\Receivify.csproj" />
  </ItemGroup>

  <!--
    No PackageReference, deliberately.

    xUnit, NUnit and MSTest all require a NuGet restore, and the SDK's own rule is zero third-party
    dependencies. These tests are a plain console runner: `dotnet run` executes them, prints a
    pass/fail line per case and exits non-zero on any failure, which is all CI needs. They are
    entirely offline — the HTTP layer is injected as a fake HttpMessageHandler and no socket is
    ever opened.
  -->

</Project>
