# Copy to .env.local and fill in. Never commit it.
# These are read on the SERVER only (no NEXT_PUBLIC_ prefix), so they never reach the browser.

# Dashboard -> API keys
RECEIVIFY_API_KEY=
# Dashboard -> Webhooks -> signing secret (comma-separate new,old during a rotation)
RECEIVIFY_WEBHOOK_SECRET=
RECEIVIFY_API_URL=https://receivify.io

# Public URL of this app, used for the absolute redirect after checkout.
APP_URL=http://localhost:3000
