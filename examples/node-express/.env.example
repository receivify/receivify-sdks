# Copy to .env and fill in. Never commit .env.

# Dashboard -> API keys. Server-side only: it can create invoices on your account.
RECEIVIFY_API_KEY=

# Dashboard -> Webhooks -> signing secret. Used to prove a webhook really came from Receivify.
RECEIVIFY_WEBHOOK_SECRET=

# Leave as is unless you were given a different API host.
RECEIVIFY_API_URL=https://receivify.io

# The public URL of THIS app (used to build the "back to shop" link on the order page).
APP_URL=http://localhost:3000
PORT=3000
# 127.0.0.1 = only this machine can reach the dev server. Use 0.0.0.0 in a container.
HOST=127.0.0.1
